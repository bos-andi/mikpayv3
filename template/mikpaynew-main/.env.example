APP_NAME=mikpay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zona waktu deploy (IANA). WIB=Asia/Jakarta, WITA=Asia/Makassar, WIT=Asia/Jayapura
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MIKPAY (optional overrides)
# Tanggal mulai pencatatan tagihan (tunggakan dihitung sejak bulan ini; bukan dari tahun mulai berlangganan pelanggan)
# BILLING_TRACKING_START_DATE=2026-01-01
# MIKPAY_ADMIN_USERNAME=mikpay
# MIKPAY_ADMIN_PASSWORD=1234
# MIKROTIK_API_PORT=8728
# MIKROTIK_TIMEOUT=3
# MIKROTIK_READ_TIMEOUT=45
# MIKROTIK_SSL=false

# Manual payment (langganan)
# Nomor WhatsApp admin untuk tombol "Kirim WhatsApp" saat user menunggu verifikasi (jika tidak diisi di Super Admin → Paket langganan).
# MIKPAY_SUBSCRIPTION_VERIFY_WHATSAPP=6281234567890
# Urutan channel pembayaran langganan & harga paket / fitur premium diatur di Super Admin → "Paket langganan" (/superadmin/subscription-pricing).
# Transfer bank: isi ketiga variabel di bawah agar opsi "Bank Transfer" muncul (kosong = disembunyikan).
# PAYMENT_BANK_NAME=BCA
# PAYMENT_BANK_ACCOUNT=1234567890
# PAYMENT_BANK_ACCOUNT_NAME=Nama Pemilik Rekening
# E-Wallet: isi nomor (dan opsional nama); tanpa PAYMENT_EWALLET_NUMBER opsi e-wallet disembunyikan.
# PAYMENT_EWALLET_NAME=DANA / OVO / GoPay
# PAYMENT_EWALLET_NUMBER=081234567890
# QRIS: selalu tampil dengan default; baris di bawah hanya override opsional.
# PAYMENT_QRIS_MERCHANT_NAME=MIKPAY ANNETWIFI
# PAYMENT_QRIS_NMID=ID1025372982195
# PAYMENT_QRIS_TERMINAL_ID=A01
# PAYMENT_QRIS_IMAGE=mikpay/img/qris_mikpay.png

# Super Admin — tidak ada baris di tabel users; login /superadmin/login memakai session
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
# Password superadmin (plain di .env — tidak perlu bcrypt di sini)
SUPERADMIN_PASSWORD=ubah_password_ini
# Opsional: jika SUPERADMIN_PASSWORD dikosongkan, bisa pakai bcrypt:
# SUPERADMIN_PASSWORD_HASH=
