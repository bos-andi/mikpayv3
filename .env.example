APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# WIB=Asia/Jakarta, WITA=Asia/Makassar, WIT=Asia/Jayapura
APP_TIMEZONE=Asia/Jakarta

# Billing: lantai hitung tunggakan (Y-m-d). Kosong = pakai started_at pelanggan.
MIKPAY_BILLING_TRACKING_START=
MIKPAY_BILLING_GRACE_DAYS=2

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MikPay site settings
MIKPAY_BRAND_NAME=MikPay
MIKPAY_BRAND_DOMAIN=MikPay.link
MIKPAY_BRAND_TAGLINE="NMS & Billing System"
MIKPAY_BRAND_INITIAL=M
MIKPAY_WA_NUMBER=6281234567890
MIKPAY_WA_TRIAL_MESSAGE="Halo Admin MikPay, saya ingin coba gratis 3 hari"
MIKPAY_TRIAL_DAYS=3
MIKPAY_SUPERADMIN_EMAILS=me@andidev.id
MIKPAY_WA_CONSULT_MESSAGE="Halo Admin MikPay, saya ingin mencoba gratis"
MIKPAY_DEMO_URL=/dashboard
MIKPAY_CENTRAL_DOMAIN=mikpay.link
MIKPAY_TENANT_BASE_DOMAIN=mikpay.link
MIKPAY_REMOTE_BASE_DOMAIN=remote.mikpay.link

# Platform payment default (locked — not editable from ISP panel)
MIKPAY_DEFAULT_PAYMENT_GATEWAY=xendit
XENDIT_ENABLED=true
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
